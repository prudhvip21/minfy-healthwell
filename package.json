{
  "name": "healthwise-platform-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run uvicorn backend.main:app --port 4000",
    "dev:api:watch": "uv run uvicorn backend.main:app --port 4000 --reload --reload-dir backend",
    "dev:web": "vite",
    "import": "uv run python -m backend.plan_import",
    "reset": "uv run python -m backend.reset",
    "test": "uv run python tests/test_engine_golden.py",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
